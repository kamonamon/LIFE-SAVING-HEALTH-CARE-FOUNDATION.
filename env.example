# Relworx Payments Uganda (official API: https://payments.relworx.com/docs)
# Copy this file to .env.local to test locally; never commit .env.local or send credentials in chat.
# The owner must create an organization/business account and associate the API key with it.
RELWORX_API_KEY=
RELWORX_ACCOUNT_NO=
# Separate stable secret for signing donation verification intents (recommended).
# Generate a long random value and keep it unchanged after launch.
RELWORX_INTENT_SECRET=
# Relworx business-account webhook authentication key, not the API key.
RELWORX_WEBHOOK_KEY=
# EXACT HTTPS webhook URL entered in Relworx business settings (including path/query).
RELWORX_WEBHOOK_URL=https://your-domain.example/api/payments/webhook
# Must be intentionally enabled after KYC and a controlled provider test.
RELWORX_ENABLED=false
# Optional public base address for documentation; not used for Relworx Mobile Money collection.
PUBLIC_SITE_URL=
